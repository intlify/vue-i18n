{
  "extends": ["config:recommended", ":preserveSemverRanges"],
  "baseBranches": ["master", "v11"],
  "labels": ["Type: Dependency"],
  "automerge": true,
  "ignoreDeps": [
    "@intlify/shared",
    "@intlify/core-base",
    "@intlify/core",
    "@intlify/vue-devtools",
    "@intlify/devtools-if",
    "@intlify/message-compiler",
    "@intlify/vue-i18n-core",
    "vue-i18n",
    "petite-vue-i18n",
    "pnpm"
  ],
  "major": {
    "automerge": false
  },
  "packageRules": [
    {
      "description": [
        "Update playwright-core on each release, because the browsers and the platforms it supports come with it.",
        "Its PRs skip the PR limits."
      ],
      "matchPackageNames": ["playwright-core"],
      "rangeStrategy": "bump",
      "prConcurrentLimit": 0,
      "prHourlyLimit": 0
    }
  ]
}
